<resources>

    <!-- Widget -->
    <plurals name="widget_minimum_cards_due_notification_ticker_text">
        <item quantity="one">%d AnkiDroid card due</item>
        <item quantity="other">%d AnkiDroid cards due</item>
    </plurals>

    <string name="widget_small" comment="Label of the small ankidroid widget. This text can't be found directly in AnkiDroid">AnkiDroid small</string>

    <plurals name="widget_cards_due">
        <item quantity="one">%d card due</item>
        <item quantity="other">%d cards due</item>
    </plurals>
    <plurals name="widget_eta">
        <item quantity="one">%d minute remaining</item>
        <item quantity="other">%d minutes remaining</item>
    </plurals>

    <string name="widget_add_note_button">Add new AnkiDroid note</string>
    <string name="deck_picker_widget_description" comment="Title of the Deck Picker Widget. Displayed to the user in Android's Widget Selection menu">Deck Picker</string>
    <string name="card_analysis_extra_widget_description">Card Analysis</string>
    <string name="word_reminder_widget_description" comment="Title of the Word reminder widget, which shows words from a deck one after another. Displayed in Android's widget selection menu">Word reminder</string>
    <string name="word_reminder_widget_empty" comment="Shown in the Word reminder widget before it has words">Enable Settings › Word reminder to see your words here</string>
    <string name="word_reminder_widget_previous" comment="Accessibility label of the button showing the previous word">Previous word</string>
    <string name="word_reminder_widget_next" comment="Accessibility label of the button showing the next word">Next word</string>

    <!-- Strings to explain usage in Deck Picker and Card Analysis Widget Configuration screen -->
    <string name="select_decks_title" comment="Title for Deck Selection Dialog">Select decks</string>
    <string name="select_deck_title" comment="Title for Deck Selection Dialog">Select a deck</string>
    <string name="no_selected_deck_placeholder_title" comment="Placeholder title when no decks are selected">Select decks to display in the widget. Select decks with the + icon.</string>
    <string name="deck_removed_from_widget" comment="Snackbar when deck is removed from widget">Deck removed</string>
    <string name="deck_already_selected_message" comment="Snackbar when user try to select the same deck again">This deck is already selected</string>
    <plurals name="deck_limit_reached">
        <item quantity="one" comment="Consider keeping the unbreakable space after the digit">You can select up to %d&#160;deck.</item>
        <item quantity="other" comment="Consider keeping the unbreakable space after the digit">You can select up to %d&#160;decks.</item>
    </plurals>
    <string name="empty_widget_state" comment="To denote the widget is empty">Missing deck. Tap to reconfigure.</string>
    <string name="empty_collection_state_in_widget" comment="To denote the collection is empty">Collection is empty, use app to add decks then reconfigure</string>"

</resources>
