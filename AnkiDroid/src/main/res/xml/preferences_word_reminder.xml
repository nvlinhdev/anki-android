<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/pref_word_reminder"
    android:key="@string/pref_word_reminder_screen_key">
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/pref_word_reminder_enabled_key"
        android:title="@string/pref_word_reminder_enabled" />
    <EditTextPreference
        android:defaultValue="GoldenDict"
        android:key="@string/pref_word_reminder_deck_key"
        android:title="@string/pref_word_reminder_deck"
        app:useSimpleSummaryProvider="true" />
    <com.ichi2.preferences.IncrementerNumberRangePreferenceCompat
        android:defaultValue="60"
        android:key="@string/pref_word_reminder_interval_key"
        android:title="@string/pref_word_reminder_interval"
        app:max="1440"
        app:min="15"
        app:summaryFormat="@plurals/pref_summ_minutes" />
    <PreferenceCategory
        android:title="@string/pref_word_reminder_quiet_summary">
        <com.ichi2.preferences.SliderPreference
            android:defaultValue="23"
            android:key="@string/pref_word_reminder_quiet_start_key"
            android:title="@string/pref_word_reminder_quiet_start"
            android:valueFrom="0"
            android:valueTo="23"
            app:displayValue="true" />
        <com.ichi2.preferences.SliderPreference
            android:defaultValue="7"
            android:key="@string/pref_word_reminder_quiet_end_key"
            android:title="@string/pref_word_reminder_quiet_end"
            android:valueFrom="0"
            android:valueTo="23"
            app:displayValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
