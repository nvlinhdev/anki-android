<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/pref_word_reminder"
    android:key="@string/pref_word_reminder_screen_key">
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="@string/pref_word_reminder_enabled_key"
        android:title="@string/pref_word_reminder_enabled" />
    <!-- entries are the collection's decks, set by WordReminderSettingsFragment -->
    <MultiSelectListPreference
        android:key="@string/pref_word_reminder_decks_key"
        android:title="@string/pref_word_reminder_decks" />
    <com.ichi2.preferences.IncrementerNumberRangePreferenceCompat
        android:defaultValue="30"
        android:key="@string/pref_word_reminder_interval_key"
        android:title="@string/pref_word_reminder_interval"
        app:max="1440"
        app:min="15"
        app:summaryFormat="@plurals/pref_summ_minutes" />
    <com.ichi2.preferences.IncrementerNumberRangePreferenceCompat
        android:defaultValue="5"
        android:key="@string/pref_word_reminder_list_size_key"
        android:title="@string/pref_word_reminder_list_size"
        app:max="20"
        app:min="1"
        app:summaryFormat="@plurals/pref_word_reminder_words" />
    <com.ichi2.preferences.IncrementerNumberRangePreferenceCompat
        android:defaultValue="15"
        android:key="@string/pref_word_reminder_slide_seconds_key"
        android:title="@string/pref_word_reminder_slide_seconds"
        app:max="60"
        app:min="2"
        app:summaryFormat="@plurals/pref_summ_seconds" />
    <PreferenceCategory
        android:title="@string/pref_word_reminder_quiet_summary">
        <com.ichi2.preferences.SliderPreference
            android:defaultValue="23"
            android:key="@string/pref_word_reminder_quiet_start_key"
            android:title="@string/pref_word_reminder_quiet_start"
            android:valueFrom="0"
            android:valueTo="23"
            app:displayValue="true" />
        <com.ichi2.preferences.SliderPreference
            android:defaultValue="7"
            android:key="@string/pref_word_reminder_quiet_end_key"
            android:title="@string/pref_word_reminder_quiet_end"
            android:valueFrom="0"
            android:valueTo="23"
            app:displayValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
